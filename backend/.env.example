# ==========================================
# Server Configuration
# ==========================================
PORT=8000
NODE_ENV=development
APP_NAME=THC_DATN_API
API_PREFIX=api/v1

# ==========================================
# MongoDB Configuration (Docker, no-auth cho dev - dễ nối Compass)
# Mongo chạy trong container thc_mongo, map port 27017 ra localhost.
# Compass: mongodb://localhost:27017/thc_datn
# Nếu Compass báo lỗi topology với replica set, dùng:
# mongodb://localhost:27017/thc_datn?directConnection=true
# ==========================================
MONGODB_URI=mongodb://localhost:27017/thc_datn
MONGODB_DB_NAME=thc_datn

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS & Security Configuration
# ==========================================
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ==========================================
# MinIO Object Storage Configuration
# ==========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=thc-datn-media
MINIO_PUBLIC_URL=http://localhost:9000

# ==========================================
# AssemblyAI Speech-to-Text Configuration
# ==========================================
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ==========================================
# FFmpeg Configuration (Tùy chọn: bỏ trống để tự dùng ffmpeg-static)
# ==========================================
FFMPEG_PATH=

# ==========================================
# Google Gemini AI Configuration
# Quản lý 6 API Key từ 6 Google AI Studio projects
# ==========================================
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here
GEMINI_API_KEY_6=your_gemini_api_key_6_here


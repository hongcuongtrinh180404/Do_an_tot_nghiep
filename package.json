{
  "name": "thc-datn-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "description": "Monorepo for DATN Graduation Project (Backend, Frontend, Share-lib)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:share": "pnpm --filter share-lib dev",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.11.2",
    "typescript": "^5.7.3"
  }
}
